# Public site URL (no trailing slash). Used for canonical links, Open Graph, sitemap, and robots.
# VITE_SITE_URL=https://lottery.comparakeet.com

# Lottery draw/jackpot API base. Defaults to /api (Vite dev proxies to 34.222.9.46).
# Production: configure your host to rewrite /api/* -> http://34.222.9.46/api/*
# VITE_LOTTERY_API_URL=/api

# theLotter affiliate (optional; defaults shown)
# VITE_THELOTTER_AFF_ID=11798
# VITE_THELOTTER_GEO_URL=https://lnk.to/TLHP
# VITE_THELOTTER_GEO_FT=5

# Content sync scripts (node scripts/sync-*.mjs) — not used by the Vite app directly
# LOTTERY_API_BASE=http://34.222.9.46/api
# WORDPRESS_API_BASE=https://lottery.comparakeet.com/wp-json/wp/v2
# WORDPRESS_SITE_ORIGIN=https://lottery.comparakeet.com
# FAQ_SYNC_DELAY_MS=150
# WP_SYNC_DELAY_MS=100
