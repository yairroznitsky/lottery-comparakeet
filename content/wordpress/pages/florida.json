  "title": "Florida Lottery Results and Winning Numbers",
  "contentHtml": "\t\t<div data-elementor-type=\"wp-page\" data-elementor-id=\"637\" class=\"elementor elementor-637\" data-elementor-post-type=\"page\">\n\t\t\t\t\t\t<section class=\"has_eae_slider elementor-section elementor-top-section elementor-element elementor-element-7874ae3a elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-eae-slider=\"75360\" data-id=\"7874ae3a\" data-element_type=\"section\" data-e-type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"has_eae_slider elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-23ec6bcf\" data-eae-slider=\"39943\" data-id=\"23ec6bcf\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-70bf6bfd elementor-widget elementor-widget-text-editor\" data-id=\"70bf6bfd\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<h2> </h2><h2>Florida Lottery Games</h2>\n<table id=\"tablepress-OpeningHours-no-4\" class=\"tablepress tablepress-id-OpeningHours tablepress-responsive\">\n<thead>\n<tr class=\"row-1\">\n\t<th class=\"column-1\">Game</th><th class=\"column-2\">Prize Type</th><th class=\"column-3\">Numbers</th><th class=\"column-4\">Sale Closes</th>\n</tr>\n</thead>\n<tbody class=\"row-striping row-hover\">\n<tr class=\"row-2\">\n\t<td class=\"column-1\">Pick 2 Midday</td><td class=\"column-2\">Top Prize</td><td class=\"column-3\">2 from 0-9</td><td class=\"column-4\">1:17 p.m.</td>\n</tr>\n<tr class=\"row-3\">\n\t<td class=\"column-1\">Pick 2 Evening</td><td class=\"column-2\">Top Prize</td><td class=\"column-3\">2 from 0-9</td><td class=\"column-4\">9:32 p.m.</td>\n</tr>\n<tr class=\"row-4\">\n\t<td class=\"column-1\">Pick 3 Midday</td><td class=\"column-2\">Top Prize</td><td class=\"column-3\">3 from 0-9</td><td class=\"column-4\">1:19 p.m.</td>\n</tr>\n<tr class=\"row-5\">\n\t<td class=\"column-1\">Pick 3 Evening</td><td class=\"column-2\">Top Prize</td><td class=\"column-3\">3 from 0-9</td><td class=\"column-4\">9:34 p.m.</td>\n</tr>\n<tr class=\"row-6\">\n\t<td class=\"column-1\">Pick 4 Midday</td><td class=\"column-2\">Top Prize</td><td class=\"column-3\">4 from 0-9</td><td class=\"column-4\">1:20 p.m.</td>\n</tr>\n<tr class=\"row-7\">\n\t<td class=\"column-1\">Pick 4 Evening</td><td class=\"column-2\">Top Prize</td><td class=\"column-3\">4 from 0-9</td><td class=\"column-4\">9:35 p.m.</td>\n</tr>\n<tr class=\"row-8\">\n\t<td class=\"column-1\">Pick 5 Midday</td><td class=\"column-2\">Top Prize</td><td class=\"column-3\">5 from 0-9</td><td class=\"column-4\">1:18 p.m.</td>\n</tr>\n<tr class=\"row-9\">\n\t<td class=\"column-1\">Pick 5 Evening</td><td class=\"column-2\">Top Prize</td><td class=\"column-3\">5 from 0-9</td><td class=\"column-4\">9:33 p.m.</td>\n</tr>\n<tr class=\"row-10\">\n\t<td class=\"column-1\">Fantasy 5</td><td class=\"column-2\">Top Prize</td><td class=\"column-3\">5 from 1-36</td><td class=\"column-4\">10:40 p.m.</td>\n</tr>\n<tr class=\"row-11\">\n\t<td class=\"column-1\">Jackpot Triple Play</td><td class=\"column-2\">Jackpot</td><td class=\"column-3\">6 from 1-46 + QP (2x)</td><td class=\"column-4\">10:40 p.m.</td>\n</tr>\n<tr class=\"row-12\">\n\t<td class=\"column-1\">Florida Lotto</td><td class=\"column-2\">Jackpot</td><td class=\"column-3\">6 from 1-53</td><td class=\"column-4\">10:40 p.m.</td>\n</tr>\n<tr class=\"row-13\">\n\t<td class=\"column-1\">Powerball</td><td class=\"column-2\">Jackpot</td><td class=\"column-3\">5 from 1-69 + 1 from 1-26</td><td class=\"column-4\">10:00 p.m.</td>\n</tr>\n<tr class=\"row-14\">\n\t<td class=\"column-1\">Mega Millions</td><td class=\"column-2\">Jackpot</td><td class=\"column-3\">5 from 1-70 + 1 from 1-25</td><td class=\