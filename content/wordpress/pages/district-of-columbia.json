  "contentHtml": "\t\t<div data-elementor-type=\"wp-page\" data-elementor-id=\"605\" class=\"elementor elementor-605\" data-elementor-post-type=\"page\">\n\t\t\t\t\t\t<section class=\"has_eae_slider elementor-section elementor-top-section elementor-element elementor-element-376fe79 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-eae-slider=\"93014\" data-id=\"376fe79\" data-element_type=\"section\" data-e-type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"has_eae_slider elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-5acb2eb9\" data-eae-slider=\"64708\" data-id=\"5acb2eb9\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-3b80ad0e elementor-widget elementor-widget-text-editor\" data-id=\"3b80ad0e\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<h2><br></h2><h2>District of Columbia Lottery Games</h2>\n<p><br></p>\n<table id=\"tablepress-OpeningHours\" class=\"tablepress tablepress-id-OpeningHours tablepress-responsive\">\n<thead>\n<tr class=\"row-1\">\n\t<th class=\"column-1\">Game</th><th class=\"column-2\">Prize Type</th><th class=\"column-3\">Numbers</th><th class=\"column-4\">Sale Closes</th>\n</tr>\n</thead>\n<tbody class=\"row-striping row-hover\">\n<tr class=\"row-2\">\n\t<td class=\"column-1\">DC-2 Mid-day</td><td class=\"column-2\">Top Prize</td><td class=\"column-3\">2 from 0-9</td><td class=\"column-4\">1:49 pm.</td>\n</tr>\n<tr class=\"row-3\">\n\t<td class=\"column-1\">DC-2 Evening</td><td class=\"column-2\">Top Prize</td><td class=\"column-3\">2 from 0-9</td><td class=\"column-4\">7:49 pm.</td>\n</tr>\n<tr class=\"row-4\">\n\t<td class=\"col