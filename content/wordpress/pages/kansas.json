  "contentHtml": "\t\t<div data-elementor-type=\"wp-page\" data-elementor-id=\"826\" class=\"elementor elementor-826\" data-elementor-post-type=\"page\">\n\t\t\t\t\t\t<section class=\"has_eae_slider elementor-section elementor-top-section elementor-element elementor-element-ce1fc12 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-eae-slider=\"3614\" data-id=\"ce1fc12\" data-element_type=\"section\" data-e-type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"has_eae_slider elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-bf93cba\" data-eae-slider=\"47446\" data-id=\"bf93cba\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-2db49463 elementor-widget elementor-widget-text-editor\" data-id=\"2db49463\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<h2>&nbsp;</h2>\n<h2>Kansas Lottery Games</h2>\n<p></p>\n<p>Only Kansas residents can take part in the following Kansas lottery games:</p>\n<p></p>\n\n<table id=\"tablepress-OpeningHours-no-3\" class=\"tablepress tablepress-id-OpeningHours tablepress-responsive\">\n<thead>\n<tr class=\"row-1\">\n\t<th class=\"column-1\">Game</th><th class=\"column-2\">Prize Type</th><th class=\"column-3\">Numbers</th><th class=\"column-4\">Sale Closes</th>\n</tr>\n</thead>\n<tbody class=\"row-striping row-hover\">\n<tr class=\"row-2\">\n\t<td class=\"column-1\">Cash 3 Midday</td><td class=\"column-2\">Top Prize</td><td class=\"column-3\">3 from 0-9</td><td class=\"column-4\">12:55 p.m.</td>\n</tr>\n<tr class=\"row-3\">\n\t<td class=\"column-1\">Cash 3 Evening</td><td class=\"column-2\">Top Prize</td><td class=\"column-3\">3 from 0-9</