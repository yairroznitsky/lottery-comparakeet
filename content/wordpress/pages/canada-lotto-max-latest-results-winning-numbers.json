tor-element-687730f7 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-eae-slider=\"78813\" data-id=\"687730f7\" data-element_type=\"section\" data-e-type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"has_eae_slider elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-2aa8a992\" data-eae-slider=\"61484\" data-id=\"2aa8a992\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-4b9cad08 elementor-widget elementor-widget-heading\" data-id=\"4b9cad08\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">About the Canada Lotto Max\n</h2>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t</div>\n\t\t\t\t\t</div>\n\t\t</section>\n\t\t\t\t<section class=\"has_eae_slider elementor-section elementor-top-section elementor-element elementor-element-6f58ea7a elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-eae-slider=\"29372\" data-id=\"6f58ea7a\" data-element_type=\"section\" data-e-type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"has_eae_slider elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-356eb9f4\" data-eae-slider=\"53974\" data-id=\"356eb9f4\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-6dfb9e7 elementor-widget elementor-widget-text-editor\" data-id=\"6dfb9e7\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"font-weight: 400;\">Lotto Max is one of the three national lottery games in Canada, coordinated by the Interprovincial Lottery Corporation (ILC). It was introduced in 2009 to replace Lotto Super 7, and although it’s similar to its predecessor, it does include additional boards.</span></p><p><span style=\"font-weight: 400;\">The </span><b>lottery Canada Lotto Max</b><span style=\"font-weight: 400;\"> also has a jackpot that starts at $10 million, and unclaimed winnings get continuously added to the pot. The grand prize is capped at $70 million and was last won in 2020.</span></p><p><span style=\"font-weight: 400;\">A great feature is MaxMillions, which activates once the pot hits $50 million. Players can win their share of thousands of smaller cash and other rewards, adding to the lotto’s popularity and making everyone a winner.</span></p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t</div>\n\t\t\t\t\t</div>\n\t\t</section>\n\t\t\t\t<section class=\"has_eae_slider elementor-section elementor-top-section elementor-element elementor-element-6b8fefc7 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-eae-slider=\"48199\" data-id=\"6b8fefc7\" data-element_type=\"section\" data-e-type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"has_eae_slider elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-4229af4d\" data-eae-slider=\"27769\" data-id=\"4229af4d\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-5659594d elementor-widget elementor-widget-heading\" data-id=\"5659594d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Canada Lotto Max FAQ</h2>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t</div>\n\t\t\t\t\t</div>\n\t\t</section>\n\t\t\t\t<section class=\"has_eae_slider elementor-section elementor-top-section elementor-element elementor-element-3369171e elementor-section-boxed elementor-section-height-default elementor-section-height-default elementor-invisible\" data-eae-slider=\"39017\" data-id=\"3369171e\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;motion_fx_motion_fx_scrolling&quot;:&quot;yes&quot;,&quot;animation&quot;:&quot;slideInUp&quot;,&quot;motion_fx_devices&quot;:[&quot;desktop&quot;,&quot;tablet&quot;,&quot;mobile&quot;]}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-wider\">\n\t\t\t\t\t<div class=\"has_eae_slider elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-21285e7\" data-eae-slider=\"4450\" data-id=\"21285e7\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-42041b4e elementor-widget elementor-widget-eael-adv-accordion\" data-id=\"42041b4e\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"eael-adv-accordion.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t            <div class=\"eael-adv-accordion\" id=\"eael-adv-accordion-42041b4e\" data-scroll-on-click=\"no\" data-scroll-speed=\"300\" data-accordion-id=\"42041b4e\" data-accordion-type=\"accordion\" data-toogle-speed=\"300\">\n            <div class=\"eael-accordion-list\">\n\t\t\t\t\t<div id=\"how-can-i-play-the-canada-lotto-max-lottery\" class=\"elementor-tab-title eael-accordion-header\" tabindex=\"0\" data-tab=\"1\" aria-controls=\"elementor-tab-content-1101\"><span class=\"eael-advanced-accordion-icon-closed\"><i aria-hidden=\"true\" class=\"fa-accordion-icon fas fa-plus\"></i></span><span class=\"eael-advanced-accordion-icon-opened\"><i aria-hidden=\"true\" class=\"fa-accordion-icon fas fa-minus\"></i></span><span class=\"eael-accordion-tab-title\">How Can I Play the Canada Lotto Max Lottery?</span><i aria-hidden=\"true\" class=\"fa-toggle fas fa-angle-right\"></i></div><div id=\"elementor-tab-content-1101\" class=\"eael-accordion-content clearfix\" data-tab=\"1\" aria-labelledby=\"how-can-i-play-the-canada-lotto-max-lottery\"><p><span style=\"font-weight: 400\">First, depending on where you live, you need to be either 18 or 19 years old. Next, you need to buy a $5 3-play ticket either online or from an approved retailer. Finally, you need to pick seven numbers between 1-50 for each section. Once the draw finishes, you can check the numbers to see if you’ve won.</span></p></div>\n\t\t\t\t\t</div><div class=\"eael-accordion-list\">\n\t\t\t\t\t<div id=\"how-do-i-win-the-canada-lotto-max-lottery\" class=\"elementor-tab-title eael-accordion-header\" tabindex=\"0\" data-tab=\"2\" aria-controls=\"elementor-tab-content-1102\"><span class=\"eael-advanced-accordion-icon-closed\"><i aria-hidden=\"true\" class=\"fa-accordion-icon fas fa-plus\"></i></span><span class=\"eael-advanced-accordion-icon-opened\"><i aria-hidden=\"true\" class=\"fa-accordion-icon fas fa-minus\"></i></span><span class=\"eael-accordion-tab-title\">How Do I Win the Canada Lotto Max Lottery?</span><i aria-hidden=\"true\" class=\"fa-toggle fas fa-angle-right\"></i></div><div id=\"elementor-tab-content-1102\" class=\"eael-accordion-content clearfix\" data-tab=\"2\" aria-labelledby=\"how-do-i-win-the-canada-lotto-max-lottery\"><p><span style=\"font-weight: 400\">During a drawing, the RNG randomly picks seven numbers. These are the winning numbers, and to get a prize, your chosen numbers should match some or all of them.</span></p><p><span style=\"font-weight: 400\">There’s a whole range of prizes available, depending on how many correct numbers you’ve picked. If you win, you’ll have 12 months to claim your reward before it expires.</span></p></div>\n\t\t\t\t\t</div><div class=\"eael-accordion-list\">\n\t\t\t\t\t<div id=\"what-are-the-odds-of-winning-the-canada-lotto-max-lottery\" class=\"elementor-tab-title eael-accordion-header\" tabindex=\"0\" data-tab=\"3\" aria-controls=\"elementor-tab-content-1103\"><span class=\"eael-advanced-accordion-icon-closed\"><i aria-hidden=\"true\" class=\"fa-accordion-icon fas fa-plus\"></i></span><span class=\"eael-advanced-accordion-icon-opened\"><i aria-hidden=\"true\" class=\"fa-accordion-icon fas fa-minus\"></i></span><span class=\"eael-accordion-tab-title\">What Are the Odds of Winning the Canada Lotto Max Lottery?</span><i aria-hidden=\"true\" class=\"fa-toggle fas fa-angle-right\"></i></div><div id=\"elementor-tab-content-1103\" class=\"eael-accordion-content clearfix\" data-tab=\"3\" aria-labelledby=\"what-are-the-odds-of-winning-the-canada-lotto-max-lottery\"><p><span style=\"font-weight: 400\">Your odds of picking the winning </span><b>Canada Lotto Max lottery numbers</b><span style=\"font-weight: 400\"> is one in 33,294,800 for every $5 of play. For MaxMillions, the odds are 1 in 28,633,528.</span></p></div>\n\t\t\t\t\t</div><div class=\"eael-accordion-list\">\n\t\t\t\t\t<div id=\"when-does-the-1-million-maxmillions-activate\" class=\"elementor-tab-title eael-accordion-header\" tabindex=\"0\" data-tab=\"4\" aria-controls=\"elementor-tab-content-1104\"><span class=\"eael-advanced-accordion-icon-closed\"><i aria-hidden=\"true\" class=\"fa-accordion-icon fas fa-plus\"></i></span><span class=\"eael-advanced-accordion-icon-opened\"><i aria-hidden=\"true\" class=\"fa-accordion-icon fas fa-minus\"></i></span><span class=\"eael-accordion-tab-title\">When Does the $1 Million Maxmillions Activate?</span><i aria-hidden=\"true\" class=\"fa-toggle fas fa-angle-right\"></i></div><div id=\"elementor-tab-content-1104\" class=\"eael-accordion-content clearfix\" data-tab=\"4\" aria-labelledby=\"when-does-the-1-million-maxmillions-activate\"><p><span style=\"font-weight: 400\">As soon as the main jackpot hits $50 million, MaxMillions will trigger, offering several smaller prize-draws alongside the main lottery.</span></p></div>\n\t\t\t\t\t</div><div class=\"eael-accordion-list\">\n\t\t\t\t\t<div id=\"who-won-the-biggest-canada-lotto-max-lottery\" class=\"elementor-tab-title eael-accordion-header\" tabindex=\"0\" data-tab=\"5\" aria-controls=\"elementor-tab-content-1105\"><span class=\"eael-advanced-accordion-icon-closed\"><i aria-hidden=\"true\" class=\"fa-accordion-icon fas fa-plus\"></i></span><span class=\"eael-advanced-accordion-icon-opened\"><i aria-hidden=\"true\" class=\"fa-accordion-icon fas fa-minus\"></i></span><span class=\"eael-accordion-tab-title\">Who Won the Biggest Canada Lotto Max Lottery?</span><i aria-hidden=\"true\" class=\"fa-toggle fas fa-angle-right\"></i></div><div id=\"elementor-tab-content-1105\" class=\"eael-accordion-content clearfix\" data-tab=\"5\" aria-labelledby=\"who-won-the-biggest-canada-lotto-max-lottery\"><p><span style=\"font-weight: 400\">None of the </span><b>Canada Lotto Max lottery winners</b><span style=\"font-weight: 400\"> have ever struck it as big as Brampton credit risk manager, Adlin Lewis. The lucky player walked away $70 million richer after winning the grand prize in January 2020.</span></p></div>\n\t\t\t\t\t</div><div class=\"eael-accordion-list\">\n\t\t\t\t\t<div id=\"when-and-where-can-i-watch-the-canada-lotto-max-lottery-draw\" class=\"elementor-tab-title eael-accordion-header\" tabindex=\"0\" data-tab=\"6\" aria-controls=\"elementor-tab-content-1106\"><span class=\"eael-advanced-accordion-icon-closed\"><i aria-hidden=\"true\" class=\"fa-accordion-icon fas fa-plus\"></i></span><span class=\"eael-advanced-accordion-icon-opened\"><i aria-hidden=\"true\" class=\"fa-accordion-icon fas fa-minus\"></i></span><span class=\"eael-accordion-tab-title\">When and Where Can I Watch the Canada Lotto Max Lottery Draw?</span><i aria-hidden=\"true\" class=\"fa-toggle fas fa-angle-right\"></i></div><div id=\"elementor-tab-content-1106\" class=\"eael-accordion-content clearfix\" data-tab=\"6\" aria-labelledby=\"when-and-where-can-i-watch-the-canada-lotto-max-lottery-draw\"><p><span style=\"font-weight: 400\">Draws are conducted every Tuesday and Friday at 9:50 pm Eastern Time.</span></p><p><span style=\"font-weight: 400\">An RNG (random number generator) picks the winning numbers, so there’s no way to watch the </span><b>Canada Lotto Max lottery results</b><span style=\"font-weight: 400\"> live. Instead, you can visit the website to see if there are animated videos of the drawing posted.</span></p><p><span style=\"font-weight: 400\">You can also use the app to see the </span><b>results of Canada Lotto Max lottery</b><span style=\"font-weight: 400\"> draws. However, if there’s a MaxMillions winner, the public posting of the numbers may be delayed.</span></p></div>\n\t\t\t\t\t</div><div class=\"eael-accordion-list\">\n\t\t\t\t\t<div id=\"how-do-i-cash-in-lottery-tickets-for-the-canada-lotto-max\" class=\"elementor-tab-title eael-accordion-header\" tabindex=\"0\" data-tab=\"7\" aria-controls=\"elementor-tab-content-1107\"><span class=\"eael-advanced-accordion-icon-closed\"><i aria-hidden=\"true\" class=\"fa-accordion-icon fas fa-plus\"></i></span><span class=\"eael-advanced-accordion-icon-opened\"><i aria-hidden=\"true\" class=\"fa-accordion-icon fas fa-minus\"></i></span><span class=\"eael-accordion-tab-title\">How Do I Cash in Lottery Tickets for the Canada Lotto Max?</span><i aria-hidden=\"true\" class=\"fa-toggle fas fa-angle-right\"></i></div><div id=\"elementor-tab-content-1107\" class=\"eael-accordion-content clearfix\" data-tab=\"7\" aria-labelledby=\"how-do-i-cash-in-lottery-tickets-for-the-canada-lotto-max\"><p><span style=\"font-weight: 400\">For wins under $1,000, you can go to your local retailer with your ticket and customer receipt, where you can use their </span><b>Canada Lotto Max lottery ticket scanner </b><span style=\"font-weight: 400\">to determine if you’re a winner.</span></p><p><span style=\"font-weight: 400\">Anything over the above amount can be claimed by going to an OLG Prize Centre. For any prizes that aren’t cash, you’ll need to contact the OLG Support Centre.</span></p></div>\n\t\t\t\t\t</div><div class=\"eael-accordion-list\">\n\t\t\t\t\t<div id=\"what-is-the-canada-lotto-max-app-for\" class=\"elementor-tab-title eael-accordion-header\" tabindex=\"0\" data-tab=\"8\" aria-controls=\"elementor-tab-content-1108\"><span class=\"eael-advanced-accordion-icon-closed\"><i aria-hidden=\"true\" class=\"fa-accordion-icon fas fa-plus\"></i></span><span class=\"eael-advanced-accordion-icon-opened\"><i aria-hidden=\"true\" class=\"fa-accordion-icon fas fa-minus\"></i></span><span class=\"eael-accordion-tab-title\">What Is the Canada Lotto Max App For?</span><i aria-hidden=\"true\" class=\"fa-toggle fas fa-angle-right\"></i></div><div id=\"elementor-tab-content-1108\" class=\"eael-accordion-content clearfix\" data-tab=\"8\" aria-labelledby=\"what-is-the-canada-lotto-max-app-for\"><p><span style=\"font-weight: 400\">You can use the </span><b>Canada Lotto Max lottery app</b><span style=\"font-weight: 400\"> to get updates on the winning numbers, prizes, or scan your ticket barcode to find out if you’re a winner.</span></p></div>\n\t\t\t\t\t</div></div>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t</div>\n\t\t\t\t\t</div>\n\t\t</section>\n\t\t\t\t<section class=\"has_eae_slider elementor-section elementor-top-section elementor-element elementor-element-1b64ac8 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-eae-slider=\"89737\" data-id=\"1b64ac8\" data-element_type=\"section\" data-e-type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"